{
  "$schema": "https://opencode.ai/config.json",
  "version": "1.0.0",
  "project": {
    "name": "CollegeAdmissionManagementSystem",
    "description": "A college admission management system built with Gradle",
    "type": "gradle"
  },
  "agents": {
    "default": "college-admission-assistant",
    "list": [
      "college-admission-assistant",
      "code-reviewer",
      "test-writer",
      "documentation-writer",
      "gradle-expert"
    ]
  },
  "skills": {
    "enabled": [
      "gradle-build",
      "java-development",
      "kotlin-development",
      "database-migration",
      "api-design",
      "testing-strategy"
    ]
  },
  "commands": {
    "custom": [
      "build",
      "test",
      "lint",
      "format",
      "run",
      "clean"
    ]
  },
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny"
    }
  },
  "lsp": {
    "gradle": {
      "command": ["gradle-language-server"],
      "args": []
    },
    "kotlin": {
      "command": ["kotlin-language-server"],
      "args": []
    }
  }
}