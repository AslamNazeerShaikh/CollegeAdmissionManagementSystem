{
  "$schema": "https://opencode.ai/config.json",
  "version": "1.0.0",
  "project": {
    "name": "CollegeAdmissionManagementSystem",
    "description": "A college admission management system built with .NET 10 + Uno Platform",
    "type": "dotnet"
  },
  "agents": {
    "default": "csharp-uno-agent",
    "list": [
      "csharp-uno-agent",
      "csharp-code-reviewer",
      "college-admission-assistant",
      "test-writer",
      "documentation-writer",
      "gradle-expert"
    ]
  },
  "skills": {
    "enabled": [
      "csharp-development",
      "gradle-build",
      "java-development",
      "kotlin-development",
      "database-migration",
      "api-design",
      "testing-strategy"
    ]
  },
  "commands": {
    "custom": [
      "dotnet-build",
      "dotnet-test",
      "dotnet-run",
      "dotnet-clean",
      "dotnet-publish",
      "dotnet-format",
      "dotnet-lint",
      "build",
      "test",
      "lint",
      "format",
      "run",
      "clean"
    ]
  },
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny"
    }
  },
  "lsp": {
    "csharp": {
      "command": ["csharp-ls"],
      "args": []
    },
    "gradle": {
      "command": ["gradle-language-server"],
      "args": []
    },
    "kotlin": {
      "command": ["kotlin-language-server"],
      "args": []
    }
  }
}