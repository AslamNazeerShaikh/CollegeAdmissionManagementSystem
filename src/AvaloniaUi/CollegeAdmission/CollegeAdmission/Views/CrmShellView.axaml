<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CollegeAdmission.ViewModels"
             xmlns:models="using:CollegeAdmission.Models"
             x:Class="CollegeAdmission.Views.CrmShellView"
             x:DataType="vm:CrmViewModel"
             Background="{StaticResource CrmPaperBg}">
  <UserControl.Styles>
    <Style Selector="Button.nav-active">
      <Setter Property="Background" Value="{StaticResource CrmPaperBg}" />
      <Setter Property="Foreground" Value="{StaticResource CrmInk}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <!-- Dense CRM shell: nav 232 + content + rail 340 on desktop (Inline SplitView);
       on narrow phones (<900dp: portrait 19.5:9/20:9, landscape) code-behind flips to
       drawer nav (Overlay), stacked rail, wrapped stats/funnel, card-style apps table.
       Desktop landscape layout is untouched. -->
  <Grid x:Name="ShellGrid" RowDefinitions="60,*">
    <!-- ══ Top bar ══ -->
    <Border Grid.Row="0" Background="{StaticResource CrmSurface}"
            BorderBrush="{StaticResource CrmLine}" BorderThickness="0,0,0,1" Padding="16,0">
      <Grid x:Name="TopGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
        <Button x:Name="NavToggle" Click="OnNavToggle" IsVisible="False"
                Background="Transparent" Padding="12,8" MinHeight="40" MinWidth="44"
                VerticalAlignment="Center" Margin="0,0,8,0">
          <!-- Drawn bars: font glyphs like ☰ don't resolve in the bundled font on Android -->
          <StackPanel Spacing="5" VerticalAlignment="Center">
            <Border Height="2.5" Width="20" CornerRadius="1" Background="{StaticResource CrmInk}" />
            <Border Height="2.5" Width="20" CornerRadius="1" Background="{StaticResource CrmInk}" />
            <Border Height="2.5" Width="20" CornerRadius="1" Background="{StaticResource CrmInk}" />
          </StackPanel>
        </Button>
        <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Search name, course, phone…  ⌘K" MaxWidth="420"
                 HorizontalAlignment="Stretch" Margin="0,0,16,0"
                 VerticalAlignment="Center" FontSize="13" />
        <ScrollViewer x:Name="StatsScroller" Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,16,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="16"
                    VerticalAlignment="Center">
          <StackPanel><TextBlock Text="TOTAL" FontSize="10" Foreground="{StaticResource CrmMuted}" />
            <TextBlock Text="{Binding TotalApplicants}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CrmInk}" /></StackPanel>
          <StackPanel><TextBlock Text="ENROLLED" FontSize="10" Foreground="{StaticResource CrmMuted}" />
            <TextBlock Text="{Binding EnrolledCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CrmOk}" /></StackPanel>
          <StackPanel><TextBlock Text="FEE DUE" FontSize="10" Foreground="{StaticResource CrmMuted}" />
            <TextBlock Text="{Binding FeeDueLabel}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CrmWarn}" /></StackPanel>
          <StackPanel><TextBlock Text="DOCS PENDING" FontSize="10" Foreground="{StaticResource CrmMuted}" />
            <TextBlock Text="{Binding DocsPendingCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CrmBad}" /></StackPanel>
        </StackPanel>
        </ScrollViewer>
        <Button Grid.Column="2" Content="+ New enquiry" Command="{Binding AddEnquiryCommand}"
                Background="{StaticResource CrmAccent}" Foreground="{StaticResource CrmAccentInk}"
                FontWeight="SemiBold" CornerRadius="6" Padding="14,8" Margin="0,0,8,0"
                VerticalAlignment="Center" MinHeight="40" />
        <Button Grid.Column="3" Content="+ New application" Command="{Binding AddApplicationCommand}"
                Background="Transparent" Foreground="{StaticResource CrmInk2}"
                BorderBrush="{StaticResource CrmLine}" BorderThickness="1"
                CornerRadius="8" Padding="12,8" VerticalAlignment="Center" MinHeight="40" />
      </Grid>
    </Border>

    <!-- ══ Body: nav lives in a SplitView (Inline pane on desktop, Overlay drawer on phones) ══ -->
    <SplitView x:Name="NavSplit" Grid.Row="1" OpenPaneLength="300"
               DisplayMode="Inline" IsPaneOpen="True">
      <SplitView.Pane>
      <!-- ── Nav ── -->
      <Border Background="{StaticResource CrmSurface}"
              BorderBrush="{StaticResource CrmLine}" BorderThickness="0,0,1,0" Padding="16">
        <StackPanel x:Name="NavPanel" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,2">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource CrmAccent}"
                    VerticalAlignment="Center">
              <TextBlock Text="✦" FontSize="18" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="0">
              <TextBlock Text="College Admissions" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" />
              <TextBlock Text="CRM" FontSize="12" Foreground="{StaticResource CrmMuted}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="2026–27 admission cycle" FontSize="11" Foreground="{StaticResource CrmMuted}" Margin="0,0,0,12" />
          <Button Content="Dashboard" Command="{Binding SelectSectionCommand}" CommandParameter="Dashboard"
                  Classes.nav-active="{Binding ShowDashboard}"
                  Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="10,8" CornerRadius="8" MinHeight="40" FontSize="14" />
          <Button Content="Pipeline" Command="{Binding SelectSectionCommand}" CommandParameter="Pipeline"
                  Classes.nav-active="{Binding ShowPipeline}"
                  Background="Transparent"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="10,8" CornerRadius="8" MinHeight="40" FontSize="14" />
          <Button Content="Applications" Command="{Binding SelectSectionCommand}" CommandParameter="Applications"
                  Classes.nav-active="{Binding ShowApplications}"
                  Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="10,8" CornerRadius="8" MinHeight="40" FontSize="14" />
          <Button Content="Courses" Command="{Binding SelectSectionCommand}" CommandParameter="Courses"
                  Classes.nav-active="{Binding ShowCourses}"
                  Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="10,8" CornerRadius="8" MinHeight="40" FontSize="14" />
          <Button Content="Fees" Command="{Binding SelectSectionCommand}" CommandParameter="Fees"
                  Classes.nav-active="{Binding ShowFees}"
                  Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="10,8" CornerRadius="8" MinHeight="40" FontSize="14" />
          <Border Height="1" Background="{StaticResource CrmLineSoft}" Margin="0,12" />
          <TextBlock Text="MANAGEMENT" FontSize="11" Foreground="{StaticResource CrmMuted}" Margin="10,0,0,4" />
          <Border Background="{StaticResource CrmPaperBg}" CornerRadius="8" Padding="10">
            <StackPanel Spacing="2">
              <TextBlock Text="Counsellor desk · Latur" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" />
              <TextBlock Text="↑↓ move · → advance · / search" FontSize="11" Foreground="{StaticResource CrmMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      </SplitView.Pane>
      <SplitView.Content>
      <!-- ── Content + rail (side rail on desktop, stacked below on phones) ── -->
      <Grid x:Name="BodyGrid" ColumnDefinitions="*,340">
      <ScrollViewer x:Name="ContentScroll" Grid.Column="0" Padding="16">
        <StackPanel Spacing="16">

          <!-- DASHBOARD -->
          <StackPanel Spacing="12" IsVisible="{Binding ShowDashboard}">
            <StackPanel Spacing="2">
              <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" />
              <TextBlock Text="{Binding TotalApplicants, StringFormat='{}{0} applicants · 2026–27 cycle'}" FontSize="13" Foreground="{StaticResource CrmMuted}" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
              <Border MinWidth="160" Background="{StaticResource CrmSurface}" CornerRadius="12" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="18,16" Margin="0,0,12,12">
                <StackPanel Spacing="2"><TextBlock Text="Total applicants" FontSize="13" Foreground="{StaticResource CrmMuted}" /><TextBlock Text="{Binding TotalApplicants}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" /><TextBlock Text="2026–27 cycle" FontSize="13" Foreground="{StaticResource CrmMuted}" /></StackPanel>
              </Border>
              <Border MinWidth="160" Background="{StaticResource CrmSurface}" CornerRadius="12" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="18,16" Margin="0,0,12,12">
                <StackPanel Spacing="2"><TextBlock Text="New enquiries" FontSize="13" Foreground="{StaticResource CrmMuted}" /><TextBlock Text="{Binding CountEnquiry}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource CrmInfo}" /><TextBlock Text="need counsellor" FontSize="13" Foreground="{StaticResource CrmMuted}" /></StackPanel>
              </Border>
              <Border MinWidth="160" Background="{StaticResource CrmSurface}" CornerRadius="12" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="18,16" Margin="0,0,12,12">
                <StackPanel Spacing="2"><TextBlock Text="Enrolled" FontSize="13" Foreground="{StaticResource CrmMuted}" /><TextBlock Text="{Binding EnrolledCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" /><TextBlock Text="admissions confirmed" FontSize="13" Foreground="{StaticResource CrmMuted}" /></StackPanel>
              </Border>
              <Border MinWidth="160" Background="{StaticResource CrmSurface}" CornerRadius="12" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="18,16" Margin="0,0,12,12">
                <StackPanel Spacing="2"><TextBlock Text="Fees due" FontSize="13" Foreground="{StaticResource CrmMuted}" /><TextBlock Text="{Binding FeeDueLabel}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" /><TextBlock Text="{Binding FeeDueCount, StringFormat='{}{0} applicants'}" FontSize="13" Foreground="{StaticResource CrmMuted}" /></StackPanel>
              </Border>
              <Border MinWidth="160" Background="{StaticResource CrmSurface}" CornerRadius="12" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="18,16" Margin="0,0,12,12">
                <StackPanel Spacing="2"><TextBlock Text="Docs pending" FontSize="13" Foreground="{StaticResource CrmMuted}" /><TextBlock Text="{Binding DocsPendingCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource CrmBad}" /><TextBlock Text="awaiting verification" FontSize="13" Foreground="{StaticResource CrmMuted}" /></StackPanel>
              </Border>
            </WrapPanel>
            <TextBlock Text="Needs action today" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" />
            <ItemsControl ItemsSource="{Binding ActionQueue}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CrmAction">
                  <Border Background="{StaticResource CrmSurface}" CornerRadius="8"
                          BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Grid.Column="0" Background="{StaticResource CrmWarnBg}" CornerRadius="6"
                              Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CrmWarn}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource CrmInk2}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Intake funnel" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" />
            <Border Background="{StaticResource CrmSurface}" CornerRadius="8"
                    BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="12">
              <!-- WrapPanel: single row on desktop, wraps to rows on narrow phones -->
              <WrapPanel Orientation="Horizontal">
                <StackPanel MinWidth="96" Margin="0,0,16,8"><TextBlock Text="{Binding CountEnquiry}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmInk}" HorizontalAlignment="Center" /><TextBlock Text="Enquiry" FontSize="11" Foreground="{StaticResource CrmMuted}" HorizontalAlignment="Center" /></StackPanel>
                <StackPanel MinWidth="96" Margin="0,0,16,8"><TextBlock Text="{Binding CountApplied}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmInk}" HorizontalAlignment="Center" /><TextBlock Text="Applied" FontSize="11" Foreground="{StaticResource CrmMuted}" HorizontalAlignment="Center" /></StackPanel>
                <StackPanel MinWidth="96" Margin="0,0,16,8"><TextBlock Text="{Binding CountVerified}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmInk}" HorizontalAlignment="Center" /><TextBlock Text="Verified" FontSize="11" Foreground="{StaticResource CrmMuted}" HorizontalAlignment="Center" /></StackPanel>
                <StackPanel MinWidth="96" Margin="0,0,16,8"><TextBlock Text="{Binding CountMerit}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmAccent}" HorizontalAlignment="Center" /><TextBlock Text="Merit" FontSize="11" Foreground="{StaticResource CrmMuted}" HorizontalAlignment="Center" /></StackPanel>
                <StackPanel MinWidth="96" Margin="0,0,16,8"><TextBlock Text="{Binding CountOffered}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmInk}" HorizontalAlignment="Center" /><TextBlock Text="Offered" FontSize="11" Foreground="{StaticResource CrmMuted}" HorizontalAlignment="Center" /></StackPanel>
                <StackPanel MinWidth="96" Margin="0,0,16,8"><TextBlock Text="{Binding CountFeePaid}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmWarn}" HorizontalAlignment="Center" /><TextBlock Text="Fee paid" FontSize="11" Foreground="{StaticResource CrmMuted}" HorizontalAlignment="Center" /></StackPanel>
                <StackPanel MinWidth="96" Margin="0,0,16,8"><TextBlock Text="{Binding CountEnrolled}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmOk}" HorizontalAlignment="Center" /><TextBlock Text="Enrolled" FontSize="11" Foreground="{StaticResource CrmMuted}" HorizontalAlignment="Center" /></StackPanel>
              </WrapPanel>
            </Border>
            <TextBlock Text="Course fill %" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" />
            <ItemsControl ItemsSource="{Binding Fills}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CourseFill">
                  <Border Background="{StaticResource CrmSurface}" CornerRadius="8"
                          BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="140,*,70">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" VerticalAlignment="Center" />
                      <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding Total}" Value="{Binding Filled}" Height="8" VerticalAlignment="Center" Margin="12,0" />
                      <TextBlock Grid.Column="2" Text="{Binding PctLabel}" FontSize="12" Foreground="{StaticResource CrmInk2}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- PIPELINE -->
          <StackPanel Spacing="12" IsVisible="{Binding ShowPipeline}">
            <Grid x:Name="PipeHeader" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
              <TextBlock x:Name="PipeTitle" Grid.Column="0" Text="Admission pipeline — merit board" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmInk}" />
              <TextBlock x:Name="PipeHint" Grid.Column="1" Text="click a card → detail rail · Advance moves stage" FontSize="11" Foreground="{StaticResource CrmMuted}" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="212" Background="{StaticResource CrmSurface}" CornerRadius="8" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8" VerticalAlignment="Top">
                  <StackPanel Spacing="8"><TextBlock Text="Enquiry" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CrmInk}" /><ItemsControl ItemsSource="{Binding LaneEnquiry}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:Applicant"><Button Tag="{Binding}" Click="OnApplicantClick" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Border Background="{StaticResource CrmPaperBg}" CornerRadius="6" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8"><StackPanel Spacing="4"><TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" /><TextBlock Text="{Binding Course}" FontSize="11" Foreground="{StaticResource CrmMuted}" TextWrapping="Wrap" /><TextBlock Text="{Binding DocsLabel}" FontSize="11" Foreground="{StaticResource CrmInk2}" /></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <Border Width="212" Background="{StaticResource CrmSurface}" CornerRadius="8" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8" VerticalAlignment="Top">
                  <StackPanel Spacing="8"><TextBlock Text="Applied" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CrmInk}" /><ItemsControl ItemsSource="{Binding LaneApplied}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:Applicant"><Button Tag="{Binding}" Click="OnApplicantClick" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Border Background="{StaticResource CrmPaperBg}" CornerRadius="6" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8"><StackPanel Spacing="4"><TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" /><TextBlock Text="{Binding Course}" FontSize="11" Foreground="{StaticResource CrmMuted}" TextWrapping="Wrap" /><TextBlock Text="{Binding DocsLabel}" FontSize="11" Foreground="{StaticResource CrmInk2}" /></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <Border Width="212" Background="{StaticResource CrmSurface}" CornerRadius="8" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8" VerticalAlignment="Top">
                  <StackPanel Spacing="8"><TextBlock Text="Verified" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CrmInk}" /><ItemsControl ItemsSource="{Binding LaneVerified}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:Applicant"><Button Tag="{Binding}" Click="OnApplicantClick" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Border Background="{StaticResource CrmPaperBg}" CornerRadius="6" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8"><StackPanel Spacing="4"><TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" /><TextBlock Text="{Binding Course}" FontSize="11" Foreground="{StaticResource CrmMuted}" TextWrapping="Wrap" /><TextBlock Text="{Binding DocsLabel}" FontSize="11" Foreground="{StaticResource CrmInk2}" /></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <Border Width="212" Background="{StaticResource CrmAccentSoft}" CornerRadius="8" BorderBrush="{StaticResource CrmAccent}" BorderThickness="1" Padding="8" VerticalAlignment="Top">
                  <StackPanel Spacing="8"><TextBlock Text="★ Merit" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CrmAccent}" /><ItemsControl ItemsSource="{Binding LaneMerit}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:Applicant"><Button Tag="{Binding}" Click="OnApplicantClick" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Border Background="{StaticResource CrmSurface}" CornerRadius="6" BorderBrush="{StaticResource CrmAccent}" BorderThickness="1" Padding="8"><StackPanel Spacing="4"><TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" /><TextBlock Text="{Binding Course}" FontSize="11" Foreground="{StaticResource CrmMuted}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding MeritPct}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CrmAccent}" /><TextBlock Text="{Binding DocsLabel}" FontSize="11" Foreground="{StaticResource CrmInk2}" VerticalAlignment="Center" /></StackPanel></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <Border Width="212" Background="{StaticResource CrmSurface}" CornerRadius="8" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8" VerticalAlignment="Top">
                  <StackPanel Spacing="8"><TextBlock Text="Offered" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CrmInk}" /><ItemsControl ItemsSource="{Binding LaneOffered}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:Applicant"><Button Tag="{Binding}" Click="OnApplicantClick" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Border Background="{StaticResource CrmPaperBg}" CornerRadius="6" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8"><StackPanel Spacing="4"><TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" /><TextBlock Text="{Binding FeeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CrmWarn}" /><TextBlock Text="{Binding DocsLabel}" FontSize="11" Foreground="{StaticResource CrmInk2}" /></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <Border Width="212" Background="{StaticResource CrmSurface}" CornerRadius="8" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8" VerticalAlignment="Top">
                  <StackPanel Spacing="8"><TextBlock Text="Fee paid" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CrmWarn}" /><ItemsControl ItemsSource="{Binding LaneFeePaid}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:Applicant"><Button Tag="{Binding}" Click="OnApplicantClick" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Border Background="{StaticResource CrmWarnBg}" CornerRadius="6" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="8"><StackPanel Spacing="4"><TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" /><TextBlock Text="Paid ✓" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CrmOk}" /></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <Border Width="212" Background="{StaticResource CrmOkBg}" CornerRadius="8" BorderBrush="{StaticResource CrmOk}" BorderThickness="1" Padding="8" VerticalAlignment="Top">
                  <StackPanel Spacing="8"><TextBlock Text="Enrolled ✓" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CrmOk}" /><ItemsControl ItemsSource="{Binding LaneEnrolled}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:Applicant"><Button Tag="{Binding}" Click="OnApplicantClick" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,6"><Border Background="{StaticResource CrmSurface}" CornerRadius="6" BorderBrush="{StaticResource CrmOk}" BorderThickness="1" Padding="8"><StackPanel Spacing="4"><TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" /><TextBlock Text="{Binding Course}" FontSize="11" Foreground="{StaticResource CrmMuted}" TextWrapping="Wrap" /></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </StackPanel>

          <!-- APPLICATIONS -->
          <StackPanel Spacing="12" IsVisible="{Binding ShowApplications}">
            <TextBlock Text="Applications — dense register" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmInk}" />
            <Border x:Name="AppsHeader" Background="{StaticResource CrmSurface}" CornerRadius="8" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="12,8">
              <Grid ColumnDefinitions="2*,2*,*,*,*,*" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="NAME" FontSize="10" Foreground="{StaticResource CrmMuted}" />
                <TextBlock Grid.Column="1" Text="COURSE" FontSize="10" Foreground="{StaticResource CrmMuted}" />
                <TextBlock Grid.Column="2" Text="STAGE" FontSize="10" Foreground="{StaticResource CrmMuted}" />
                <TextBlock Grid.Column="3" Text="MERIT" FontSize="10" Foreground="{StaticResource CrmMuted}" />
                <TextBlock Grid.Column="4" Text="DOCS" FontSize="10" Foreground="{StaticResource CrmMuted}" />
                <TextBlock Grid.Column="5" Text="FEE" FontSize="10" Foreground="{StaticResource CrmMuted}" />
              </Grid>
            </Border>
            <ItemsControl x:Name="AppsRows" ItemsSource="{Binding FilteredApplicants}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Applicant">
                  <Button Tag="{Binding}" Click="OnApplicantClick" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                    <Border Background="{StaticResource CrmSurface}" CornerRadius="6" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="12,8">
                      <Grid ColumnDefinitions="2*,2*,*,*,*,*">
                        <TextBlock Grid.Column="0" Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Course}" FontSize="12" Foreground="{StaticResource CrmInk2}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding StageName}" FontSize="12" Foreground="{StaticResource CrmAccent}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding MeritPct}" FontSize="13" Foreground="{StaticResource CrmInk}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding DocsLabel}" FontSize="12" Foreground="{StaticResource CrmInk2}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding FeeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CrmWarn}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Narrow phones: stacked cards instead of the 6-column table -->
            <ItemsControl x:Name="AppsCards" ItemsSource="{Binding FilteredApplicants}" IsVisible="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Applicant">
                  <Button Tag="{Binding}" Click="OnApplicantClick" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                    <Border Background="{StaticResource CrmSurface}" CornerRadius="8" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="12,10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Course}" FontSize="12" Foreground="{StaticResource CrmMuted}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding StageName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CrmAccent}" />
                          <TextBlock Text="{Binding MeritPct}" FontSize="12" Foreground="{StaticResource CrmInk}" />
                          <TextBlock Text="{Binding DocsLabel}" FontSize="12" Foreground="{StaticResource CrmInk2}" />
                          <TextBlock Text="{Binding FeeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CrmWarn}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- COURSES -->
          <StackPanel Spacing="12" IsVisible="{Binding ShowCourses}">
            <TextBlock Text="Course catalog — seats, fees, syllabi" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmInk}" />
            <ItemsControl ItemsSource="{Binding Courses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Course">
                  <Border Background="{StaticResource CrmSurface}" CornerRadius="8" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding CardTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding CardSubtitle}" FontSize="12" Foreground="{StaticResource CrmInk2}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Tag="{Binding FySyllabusUrl}" Click="OnSyllabusClick" Content="FY syllabus"
                                IsEnabled="{Binding HasFy}" Padding="10,6" CornerRadius="6" FontSize="12" MinHeight="36" />
                        <Button Tag="{Binding SySyllabusUrl}" Click="OnSyllabusClick" Content="SY syllabus"
                                IsEnabled="{Binding HasSy}" Padding="10,6" CornerRadius="6" FontSize="12" MinHeight="36" />
                        <Button Tag="{Binding TySyllabusUrl}" Click="OnSyllabusClick" Content="TY syllabus"
                                IsEnabled="{Binding HasTy}" Padding="10,6" CornerRadius="6" FontSize="12" MinHeight="36" />
                        <Button Tag="{Binding Id}" Click="OnApplyClick" Content="Apply →"
                                Background="{StaticResource CrmAccent}" Foreground="{StaticResource CrmAccentInk}"
                                Padding="10,6" CornerRadius="6" FontSize="12" FontWeight="SemiBold" MinHeight="36" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- FEES -->
          <StackPanel Spacing="12" IsVisible="{Binding ShowFees}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Fees — collection queue" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CrmInk}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Outstanding:" FontSize="12" Foreground="{StaticResource CrmMuted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FeeDueLabel}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CrmWarn}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding FeeDueList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Applicant">
                  <Border Background="{StaticResource CrmSurface}" CornerRadius="8" BorderBrush="{StaticResource CrmLine}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" />
                        <TextBlock Text="{Binding Course}" FontSize="12" Foreground="{StaticResource CrmMuted}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding FeeLabel}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CrmWarn}" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <Button Grid.Column="2" Tag="{Binding}" Click="OnCollectClick" Content="Collect"
                              Background="{StaticResource CrmOk}" Foreground="White"
                              Padding="12,6" CornerRadius="6" FontSize="12" FontWeight="SemiBold" MinHeight="36" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- ── Detail rail: right column on desktop, stacked below content on phones ── -->
      <Border x:Name="RailBorder" Grid.Column="1" Background="{StaticResource CrmSurface}"
              BorderBrush="{StaticResource CrmLine}" BorderThickness="1,0,0,0" Padding="16">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="APPLICANT" FontSize="10" Foreground="{StaticResource CrmMuted}" />
            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource CrmAccentSoft}"
                    HorizontalAlignment="Left">
              <TextBlock Text="{Binding SelectedApplicant.Initials}" FontSize="18" FontWeight="Bold"
                         Foreground="{StaticResource CrmAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding SelectedApplicant.FullName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedApplicant.Course}" FontSize="13" Foreground="{StaticResource CrmInk2}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedApplicant.Phone}" FontSize="13" Foreground="{StaticResource CrmInk}" />
            <Grid ColumnDefinitions="*,*" Margin="0,4">
              <StackPanel Grid.Column="0"><TextBlock Text="MERIT" FontSize="10" Foreground="{StaticResource CrmMuted}" />
                <TextBlock Text="{Binding SelectedApplicant.MeritPct}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource CrmAccent}" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="STAGE" FontSize="10" Foreground="{StaticResource CrmMuted}" />
                <TextBlock Text="{Binding SelectedApplicant.StageName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CrmInk}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedApplicant.DocsLabel}" FontSize="12" Foreground="{StaticResource CrmInk2}" /></StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" Margin="0,4">
              <StackPanel Grid.Column="0"><TextBlock Text="FEE" FontSize="10" Foreground="{StaticResource CrmMuted}" />
                <TextBlock Text="{Binding SelectedApplicant.FeeLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CrmWarn}" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="COUNSELLOR" FontSize="10" Foreground="{StaticResource CrmMuted}" />
                <TextBlock Text="{Binding SelectedApplicant.Counsellor}" FontSize="13" Foreground="{StaticResource CrmInk}" /></StackPanel>
            </Grid>
            <Button Content="Advance stage →" Click="OnAdvanceClick"
                    Background="{StaticResource CrmAccent}" Foreground="{StaticResource CrmAccentInk}"
                    FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="12,10" CornerRadius="6" MinHeight="44" />
            <Button Content="Collect fee" Click="OnRailCollectClick"
                    Background="{StaticResource CrmOk}" Foreground="White"
                    FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="12,10" CornerRadius="6" MinHeight="44" />
            <Button Content="New application" Click="OnRailRegisterClick"
                    Background="Transparent" Foreground="{StaticResource CrmInk2}"
                    BorderBrush="{StaticResource CrmLine}" BorderThickness="1"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="12,10" CornerRadius="6" MinHeight="44" />
            <Border Height="1" Background="{StaticResource CrmLineSoft}" Margin="0,4" />
            <TextBlock Text="ACTIVITY" FontSize="10" Foreground="{StaticResource CrmMuted}" />
            <TextBlock Text="· Enquiry logged&#x0a;· Docs uploaded for verification&#x0a;· Merit auto-computed from marks"
                       FontSize="12" Foreground="{StaticResource CrmInk2}" TextWrapping="Wrap" LineHeight="20" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      </Grid>
      </SplitView.Content>
    </SplitView>
  </Grid>
</UserControl>
