<Page x:Class="CollegeAdmission.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
      Background="White">
  <Grid>
    <ScrollViewer>
      <StackPanel Margin="10,42,10,42" Spacing="0">
        <AnimatedVisualPlayer x:Name="WelcomeAnim" AutoPlay="True"
                              Height="245" Margin="0,0,0,0"
                              HorizontalAlignment="Stretch" Stretch="Uniform">
          <lottie:LottieVisualSource UriSource="ms-appx:///Assets/Lottie/get_in_touch.json" />
        </AnimatedVisualPlayer>
        <Border Height="1" Background="#6200EE" Margin="120,10,120,10" />
        <TextBlock Text="'' Welcome to&#x0a;College of Computer Science &amp; Information&#x0a;technology's College admission management&#x0a;online system ''"
                   FontSize="12" FontWeight="Bold" FontStyle="Italic" Foreground="Black"
                   TextAlignment="Center" Margin="0,0,0,10" />
        <Border Height="1" Background="#6200EE" Margin="32,0,32,10" />
        <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
          <Button Grid.Column="0" Margin="0,0,5,0" Padding="0" Background="Transparent"
                  Click="OnRegistrationClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border MinHeight="190" Background="White" CornerRadius="4"
                    BorderBrush="#E4E4E4" BorderThickness="1" Padding="5">
              <StackPanel VerticalAlignment="Center" Spacing="4">
                <Image Source="ms-appx:///Assets/Images/table_chair.jpg" Width="78" Height="78"
                       HorizontalAlignment="Center" />
                <TextBlock Text="Registration" FontWeight="Bold" Foreground="Black" TextAlignment="Center" TextWrapping="Wrap" />
                <Border Height="1" Background="#6200EE" Margin="10,0,10,0" />
                <TextBlock Text="Admissions , Courses&#x0a; &amp; Fees Structure" Foreground="Black"
                           TextAlignment="Center" Padding="5" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Button>
          <Button Grid.Column="1" Margin="5,0,0,0" Padding="0" Background="Transparent"
                  Click="OnWalkthroughClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border MinHeight="190" Background="White" CornerRadius="4"
                    BorderBrush="#E4E4E4" BorderThickness="1" Padding="5">
              <StackPanel VerticalAlignment="Center" Spacing="4">
                <Image Source="ms-appx:///Assets/Images/boy_paper.jpg" Width="78" Height="78"
                       HorizontalAlignment="Center" />
                <TextBlock Text="Walkthrough" FontWeight="Bold" Foreground="Black" TextAlignment="Center" TextWrapping="Wrap" />
                <Border Height="1" Background="#6200EE" Margin="10,0,10,0" />
                <TextBlock Text="About us , Academics &amp; Miscellaneous" Foreground="Black"
                           TextAlignment="Center" Padding="5" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Button>
        </Grid>
        <Button Click="OnBackClick" Background="Transparent" Padding="0"
                HorizontalAlignment="Center" Margin="0,16,0,0">
          <Image Source="ms-appx:///Assets/Images/back.png" Width="32" Height="32" />
        </Button>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="ExitOverlay" Background="#80000000" Visibility="Collapsed">
      <Border Background="White" CornerRadius="4" Padding="16" Margin="50,0,50,0" MaxWidth="480"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
          <Image Source="ms-appx:///Assets/Images/old_logo.png" Width="64" Height="64"
                 HorizontalAlignment="Center" />
          <TextBlock x:Name="ExitMessage" Foreground="Black" TextWrapping="Wrap" TextAlignment="Center" />
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Content="CONTINUE" Height="50" Margin="0,0,4,0"
                    Background="#6200EE" Foreground="White" FontWeight="Bold"
                    HorizontalAlignment="Stretch" Click="OnExitAccept" />
            <Button Grid.Column="1" Content="DISMISS" Height="50" Margin="4,0,0,0"
                    Background="#FF9800" Foreground="White" FontWeight="Bold"
                    HorizontalAlignment="Stretch" Click="OnExitCancel" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Page>
