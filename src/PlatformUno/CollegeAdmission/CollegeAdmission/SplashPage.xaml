<Page x:Class="CollegeAdmission.SplashPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
  <Grid Margin="16" RowDefinitions="*,Auto,Auto,Auto,*">
    <Image Grid.Row="0" Source="ms-appx:///Assets/Images/old_logo.png"
           Width="300" Height="300" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
    <TextBlock Grid.Row="1" Text="COLLEGE ADMISSION&#x0a;MANAGEMENT SYSTEM"
               FontSize="24" FontWeight="Bold" Foreground="Black"
               TextAlignment="Center" Margin="0,30,0,0" />
    <TextBlock Grid.Row="2" Text="COLLEGE OF COMPUTER SCIENCE&#x0a;&amp; INFORMATION TECHNOLOGY&#x0a;LATUR - 413512"
               FontSize="14" FontWeight="Bold" Foreground="Gray"
               TextAlignment="Center" Margin="0,6,0,0" />
    <TextBlock Grid.Row="4" Text="version 1.0.0" FontSize="12"
               Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
  </Grid>
</Page>
