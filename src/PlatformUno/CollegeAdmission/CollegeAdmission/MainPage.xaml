<Page x:Class="CollegeAdmission.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <ScrollViewer>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="12" Padding="24" MaxWidth="480">
      <TextBlock Text="College of Computer Science &amp; Information Technology"
                 FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
      <TextBlock Text="Online Admission Management System · Latur"
                 Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" />
      <Button Content="View Courses" Click="OnCoursesClick"
              HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CoursesButton" />
      <Button Content="Register" Click="OnRegisterClick"
              HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RegisterButton" />
      <Button Content="Exit" Click="OnExitClick" HorizontalAlignment="Stretch" />
    </StackPanel>
  </ScrollViewer>
</Page>
